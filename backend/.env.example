MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/karachi-bus-finder?retryWrites=true&w=majority
PORT=5000
NODE_ENV=development

# Optional: comma-separated list of allowed CORS origins in production.
# If unset, all origins are allowed (fine for local development).
# Example: ALLOWED_ORIGINS=https://myapp.com,https://admin.myapp.com
ALLOWED_ORIGINS=

# Optional: override the path to the stops CSV used by `npm run seed`.
# Defaults to backend/data/karachi_bus_stops_coordinates_v2.csv
CSV_PATH=
